{
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "https://thefolio-api.onrender.com/api/auth/$1"
    },
    {
      "source": "/api/posts/(.*)",
      "destination": "https://thefolio-api.onrender.com/api/posts/$1"
    },
    {
      "source": "/api/comments/(.*)",
      "destination": "https://thefolio-api.onrender.com/api/comments/$1"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "https://thefolio-api.onrender.com/api/admin/$1"
    },
    {
      "source": "/api/contacts/(.*)",
      "destination": "https://thefolio-api.onrender.com/api/contacts/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://thefolio-api.onrender.com/uploads/$1"
    }
  ]
}